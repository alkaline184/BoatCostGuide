{
  "name": "boatcostguide",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "catalog:validate": "BOAT_CATALOG_VALIDATE=1 vitest run tests/unit/catalog-shopping.test.ts",
    "catalog:quality": "BOAT_CATALOG_REPORT=1 npm run catalog:validate -- --silent=false",
    "catalog:diff": "node scripts/catalog-diff.mjs",
    "catalog:vehdb": "node scripts/vehdb-evaluate.mjs",
    "catalog:theboatdb": "node scripts/marine/benchmark-theboatdb.ts",
    "dev:boatdb": "BOATDB_LOCAL_REVIEW=1 next dev --hostname 127.0.0.1 --port 3005"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.82.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
